# Plaid API credentials
# Copy this file to .env and fill in your Plaid Dashboard values.
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment: sandbox, development, or production
PLAID_ENV=development

# Optional Flask port. Defaults to 8090 if available.
# PORT=8090

# Flask session signing key. Set this to a long random string.
APP_SECRET_KEY=

# Set false after family accounts are created if you want to block self-signup.
ALLOW_SIGNUPS=true
